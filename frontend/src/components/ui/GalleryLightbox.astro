---
import { getImage } from "astro:assets";
import type { GalleryPhoto } from "../../data/gallery";

interface Props {
  photos: GalleryPhoto[];
}

const { photos } = Astro.props;
const slides = await Promise.all(photos.map(async (photo) => {
  const optimized = await getImage({
    src: photo.image,
    width: Math.min(photo.image.width, 1600),
    format: "webp",
    quality: 85,
  });
  return { src: optimized.src, alt: photo.alt, caption: photo.caption, category: photo.category };
}));
---

<hotel-gallery>
  <button
    type="button"
    data-gallery-open
    aria-haspopup="dialog"
    aria-controls="hotel-gallery-dialog"
    class="mt-8 inline-flex min-h-12 cursor-pointer items-center gap-4 border-b border-[#d72f2f]/50 pb-1 text-sm font-semibold tracking-wide transition-colors hover:text-[#bd2424] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#d72f2f]"
  >
    Ver galería completa <span aria-hidden="true" class="text-xl text-[#d72f2f]">→</span>
  </button>

  <dialog
    id="hotel-gallery-dialog"
    aria-labelledby="gallery-title"
    class="fixed inset-0 m-auto h-[min(90vh,900px)] max-h-none w-[min(94vw,1440px)] max-w-none overflow-hidden rounded-xl border border-white/15 bg-[#031b2a] p-0 text-white shadow-2xl backdrop:bg-[#031b2a]/50 backdrop:backdrop-blur-[2px]"
  >
    <div class="flex h-full flex-col">
      <header class="flex shrink-0 items-center justify-between px-6 py-4">
        <h2 id="gallery-title" class="font-serif text-2xl">El hotel, en imágenes</h2>
        <button type="button" data-gallery-close autofocus aria-label="Cerrar galería" class="grid size-12 cursor-pointer place-items-center rounded-full border border-white/25 transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
      </header>

      <div class="grid min-h-0 flex-1 grid-cols-[3rem_minmax(0,1fr)_3rem] items-center gap-4 px-6">
        <button type="button" data-gallery-previous aria-label="Foto anterior" class="grid size-12 cursor-pointer place-items-center rounded-full border border-white/25 text-2xl transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          <span aria-hidden="true">←</span>
        </button>
        <figure class="relative h-full min-h-0">
          <img data-gallery-image alt="" decoding="async" class="h-full w-full object-contain" />
          <p data-gallery-status role="status" class="pointer-events-none absolute inset-x-4 top-1/2 text-center text-sm text-white/80"></p>
        </figure>
        <button type="button" data-gallery-next aria-label="Foto siguiente" class="grid size-12 cursor-pointer place-items-center rounded-full border border-white/25 text-2xl transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          <span aria-hidden="true">→</span>
        </button>
      </div>

      <div aria-live="polite" aria-atomic="true" class="shrink-0 px-6 py-5 text-center">
        <p data-gallery-caption class="font-serif text-xl"></p>
        <p data-gallery-counter class="mt-1 text-xs tracking-wide text-white/65"></p>
      </div>
    </div>
  </dialog>

  <script is:inline type="application/json" data-gallery-images set:html={JSON.stringify(slides).replace(/</g, "\\u003c")} />
</hotel-gallery>

<script>
  import "./gallery-lightbox";
</script>
