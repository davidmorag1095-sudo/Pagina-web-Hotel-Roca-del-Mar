---
import { getImage } from "astro:assets";
import type { RoomGalleryPhoto } from "../../data/room-gallery";

interface Props {
  photos: RoomGalleryPhoto[];
}

const { photos } = Astro.props;
const galleryId = "room-gallery";
const dialogId = `${galleryId}-dialog`;
const titleId = `${galleryId}-title`;
const slides = await Promise.all(photos.map(async (photo) => {
  const [optimized, thumbnail] = await Promise.all([
    getImage({
      src: photo.image,
      width: Math.min(photo.image.width, 1600),
      format: "webp",
      quality: 85,
    }),
    getImage({
      src: photo.image,
      width: Math.min(photo.image.width, 240),
      format: "webp",
      quality: 72,
    }),
  ]);

  return {
    src: optimized.src,
    thumbnail: thumbnail.src,
    alt: photo.alt,
    caption: photo.caption,
    category: photo.category,
    roomName: photo.roomName,
    facts: photo.facts,
    description: photo.description ?? "",
  };
}));
---

<hotel-gallery>
  <button
    type="button"
    data-gallery-open
    aria-haspopup="dialog"
    aria-controls={dialogId}
    class="mt-8 inline-flex min-h-12 cursor-pointer items-center gap-4 border-b border-[#d72f2f]/50 pb-1 text-sm font-semibold tracking-wide transition-colors hover:text-[#bd2424] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#d72f2f]"
  >
    Ver galería de habitaciones <span aria-hidden="true" class="text-xl text-[#d72f2f]">→</span>
  </button>

  <dialog
    id={dialogId}
    aria-labelledby={titleId}
    class="fixed inset-0 m-auto h-[calc(100dvh-1rem)] max-h-none w-[calc(100vw-1rem)] max-w-none overflow-hidden rounded-xl border border-[#d6ad68]/45 bg-[linear-gradient(145deg,#031b2a_0%,#062638_100%)] p-0 text-left text-white shadow-[0_28px_90px_rgba(2,14,24,0.5)] backdrop:bg-[#031b2a]/60 backdrop:backdrop-blur-[2px] sm:h-[calc(100dvh-2rem)] sm:w-[calc(100vw-2rem)] lg:h-[min(90dvh,850px)] lg:w-[min(94vw,1400px)] lg:rounded-2xl"
  >
    <div class="relative grid h-full grid-rows-[auto_minmax(0,1fr)] gap-5 overflow-y-auto p-5 sm:p-6 lg:grid-cols-[minmax(250px,0.34fr)_minmax(0,1fr)] lg:grid-rows-1 lg:gap-8 lg:overflow-hidden lg:p-7">
      <button
        type="button"
        data-gallery-close
        autofocus
        aria-label="Cerrar galería de habitaciones"
        class="absolute right-3 top-3 z-30 grid size-11 cursor-pointer place-items-center rounded-full border border-[#d6ad68]/65 bg-[#031b2a]/85 text-[#e1bd7d] transition-colors hover:bg-[#d6ad68]/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d6ad68] sm:right-5 sm:top-5 sm:size-12"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>

      <aside class="flex min-w-0 flex-col pr-12 lg:pr-0 lg:pt-4">
        <p class="text-[11px] font-semibold uppercase tracking-[0.32em] text-[#e1bd7d] sm:text-xs">Galería</p>
        <h2 id={titleId} class="mt-2 font-serif text-[2rem] leading-none tracking-[-0.025em] text-[#f7f4ee] sm:text-[2.5rem] lg:text-[clamp(2.5rem,3.4vw,3.6rem)]">
          Habitaciones
        </h2>
        <div aria-hidden="true" class="mt-4 h-0.5 w-20 bg-[#d6ad68] sm:mt-5"></div>

        <p data-gallery-caption class="mt-5 max-w-xs font-serif text-xl leading-tight text-[#f7f4ee] sm:text-2xl lg:mt-10 lg:text-[1.7rem]"></p>

        <ul data-gallery-facts class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2 text-sm text-white/85 sm:grid-cols-3 lg:mt-6 lg:grid-cols-1 lg:gap-y-3">
          {Array.from({ length: 5 }).map(() => (
            <li data-gallery-fact hidden class="items-center gap-3">
              <span aria-hidden="true" class="grid size-6 shrink-0 place-items-center rounded-full border border-[#d6ad68]/45 text-[#e1bd7d]">
                <svg class="size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m3.25 8.1 2.75 2.75 6.75-6.2"></path>
                </svg>
              </span>
              <span data-gallery-fact-text></span>
            </li>
          ))}
        </ul>

        <p data-gallery-description hidden class="mt-5 max-w-sm border-t border-white/20 pt-4 text-sm leading-6 text-white/70 lg:mt-6"></p>

        <div class="mt-5 flex items-center gap-4 lg:mt-auto lg:pt-6">
          <p data-gallery-counter class="shrink-0 text-sm tracking-wide text-white/75"></p>
          <div aria-hidden="true" class="h-px flex-1 overflow-hidden bg-white/25">
            <span data-gallery-progress class="block h-full w-0 bg-[#e1bd7d] transition-[width] duration-500 ease-out"></span>
          </div>
        </div>
      </aside>

      <div class="flex min-h-0 min-w-0 flex-col justify-start lg:h-full lg:justify-center">
        <div class="relative flex min-h-0 items-center justify-center">
          <button
            type="button"
            data-gallery-previous
            aria-label="Foto anterior"
            class="absolute left-2 top-1/2 z-20 grid size-11 -translate-y-1/2 cursor-pointer place-items-center rounded-full border border-[#d6ad68]/65 bg-[#031b2a]/90 text-2xl text-[#e1bd7d] shadow-lg transition-colors hover:bg-[#0a3448] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d6ad68] sm:left-3 sm:size-12"
          >
            <span aria-hidden="true">←</span>
          </button>

          <figure class="room-gallery-frame relative aspect-[4/3] min-h-0 w-full overflow-hidden rounded-xl border border-white/10 bg-black/10 shadow-[0_20px_50px_rgba(0,0,0,0.28)]">
            <div data-gallery-layer class="absolute inset-0 opacity-0 transition-opacity duration-700 ease-out">
              <img data-gallery-image alt="" decoding="async" class="absolute inset-0 h-full w-full object-contain" />
            </div>
            <div data-gallery-layer class="absolute inset-0 opacity-0 transition-opacity duration-700 ease-out">
              <img data-gallery-image alt="" decoding="async" class="absolute inset-0 h-full w-full object-contain" />
            </div>
            <p data-gallery-status role="status" class="pointer-events-none absolute inset-x-4 top-1/2 text-center text-sm text-white/80"></p>
          </figure>

          <button
            type="button"
            data-gallery-next
            aria-label="Foto siguiente"
            class="absolute right-2 top-1/2 z-20 grid size-11 -translate-y-1/2 cursor-pointer place-items-center rounded-full border border-[#d6ad68]/65 bg-[#031b2a]/90 text-2xl text-[#e1bd7d] shadow-lg transition-colors hover:bg-[#0a3448] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d6ad68] sm:right-3 sm:size-12"
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <div class="room-gallery-thumbnails mx-auto mt-3 flex w-full max-w-[920px] gap-2 overflow-x-auto pb-1 sm:mt-4 sm:gap-3">
          {slides.map((slide, index) => (
            <button
              type="button"
              data-gallery-thumbnail
              data-gallery-thumbnail-index={index}
              data-active="false"
              aria-label={`Mostrar imagen ${index + 1}: ${slide.caption}`}
              class="aspect-[4/3] w-[76px] shrink-0 cursor-pointer overflow-hidden rounded-lg border-2 border-transparent bg-black/15 opacity-65 transition-[border-color,box-shadow,opacity,transform] hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d6ad68] data-[active=true]:border-[#e1bd7d] data-[active=true]:opacity-100 data-[active=true]:shadow-[0_0_0_2px_rgba(225,189,125,0.18)] sm:w-[92px] lg:w-[clamp(82px,7vw,110px)]"
            >
              <img src={slide.thumbnail} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </button>
          ))}
        </div>
      </div>
    </div>
  </dialog>

  <script is:inline type="application/json" data-gallery-images set:html={JSON.stringify(slides).replace(/</g, "\\u003c")} />
</hotel-gallery>

<script>
  import "./gallery-lightbox";
</script>

<style>
  .room-gallery-thumbnails {
    scrollbar-width: none;
  }

  .room-gallery-thumbnails::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 1024px) {
    .room-gallery-frame {
      width: min(100%, calc((min(90dvh, 850px) - 12rem) * 4 / 3));
    }
  }
</style>
