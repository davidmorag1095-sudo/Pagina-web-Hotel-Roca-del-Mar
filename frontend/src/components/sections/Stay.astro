---
import { Image } from "astro:assets";
import GalleryLightbox from "../ui/GalleryLightbox.astro";
import { galleryPhotos } from "../../data/gallery";

const featuredPhotos = galleryPhotos.filter((photo) => photo.featured);
const mainPhoto = galleryPhotos.find((photo) => photo.caption === "Los exteriores del hotel") ?? featuredPhotos[0];
const stackedPhotos = [
  galleryPhotos.find((photo) => photo.category === "Mar") ?? galleryPhotos[8],
  galleryPhotos.find((photo) => photo.caption === "Detalles de nuestros jardines") ?? featuredPhotos[1],
];
const visiblePhotos = [mainPhoto, ...stackedPhotos];
const lightboxPhotos = galleryPhotos.filter((photo) => !visiblePhotos.includes(photo));
---

<section id="galeria" aria-labelledby="stay-heading" class="bg-[#f7f4ee] px-[4vw] py-12 text-[#031b2a]">
  <div class="grid grid-cols-[minmax(0,0.8fr)_minmax(0,1.65fr)] items-center gap-[3.5vw]">
    <div class="max-w-[410px]">
      <h2 id="stay-heading" class="font-serif text-[clamp(2.1rem,2.7vw,2.75rem)] leading-[1.08] tracking-[-0.025em]">
        Una estancia tranquila en Puntarenas
      </h2>
      <div class="mt-5 space-y-3 text-[15px] leading-[1.65] text-[#475963]">
        <p>
          Entre palmeras, jardines y una piscina al aire libre, encuentra un lugar
          para bajar el ritmo y disfrutar de Puntarenas con calma.
        </p>
        <p>
          En Hotel La Roca del Mar, la cercanía del Pacífico y la atención directa
          acompañan una estadía sencilla, cómoda y sin prisas.
        </p>
      </div>
      <GalleryLightbox photos={lightboxPhotos} />
    </div>

    <div class="grid h-[clamp(270px,23vw,320px)] w-full max-w-[760px] grid-cols-[minmax(0,1.85fr)_minmax(0,1fr)] items-stretch justify-self-end gap-3">
      <figure class="h-full overflow-hidden rounded-xl">
        <Image
          src={mainPhoto.image}
          alt={mainPhoto.alt}
          width={900}
          format="webp"
          quality={82}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </figure>

      <div class="grid min-h-0 grid-rows-2 gap-3">
        {stackedPhotos.map((photo) => (
          <figure class="min-h-0 overflow-hidden rounded-xl">
            <Image
              src={photo.image}
              alt={photo.alt}
              width={500}
              format="webp"
              quality={82}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
